{
  "type": "application",
  "id": "model_viewer",
  "version": "1.4.0",
  "architecture": "xtensa-esp32s3",
  "file_name": "model_viewer.elf",
  "entry": "app_main",
  "display_name": "3D Model Viewer",
  "icon": "regular:f03e",
  "requires": [
    {
      "capability": "ui.canvas",
      "api": 1
    }
  ],
  "supported_file_types": [
    ".obj",
    ".stl"
  ],
  "optional": [
    {
      "capability": "storage.app-data",
      "api": 1
    },
    {
      "capability": "storage.volume",
      "api": 1
    },
    {
      "capability": "file.open",
      "api": 1
    },
    {
      "capability": "file.open.source",
      "api": 1
    },
    {
      "capability": "usb.hid.gamepad",
      "api": 1
    },
    {
      "capability": "usb.xinput.gamepad",
      "api": 1
    }
  ]
