static void spectrum_presenter_commit(const risc_components_document_v1*d){sp_presented=*d;sp_presented_page=page;}
static bool spectrum_presenter_back(void){
 if(!spectrum_domain_alive())return false;
 if(page>=PAGE_SHARED){(void)shared_back();}else if(page==PAGE_MAIN){if(lab_edit){lab_edit=false;set_page(PAGE_MAIN);}else spectrum_presenter_exit_requested=signature_exit_ready()&&temporal_exit_ready();}else if(page==PAGE_LABEL)set_page(PAGE_MAIN);else if(page==PAGE_SIGNATURE_EDIT)set_page(PAGE_SIGNATURES);else if(page==PAGE_SIGNATURES)set_page(PAGE_CONTROLS);else if(page==PAGE_EVENTS){toast_message=NULL;set_page(PAGE_CONTROLS);}else if(page==PAGE_EVENT_CAPTURE){if(event_armed||event_training.ready)notify("SAVE OR CANCEL THE WINDOW");else set_page(PAGE_EVENT_LABEL);}else if(page==PAGE_EVENT_EXAMPLES)set_page(PAGE_EVENT_LABEL);else if(page==PAGE_EVENT_LABEL){toast_message=NULL;set_page(PAGE_EVENTS);}else set_page(PAGE_MAIN);return true;
}
