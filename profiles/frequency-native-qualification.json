{
  "schema": 1,
  "purpose": "Qualification-only native Frequency candidate; no catalog or publication",
  "publish_to_catalog": false,
  "application": {
    "type": "application",
    "id": "frequency_generator",
    "display_name": "Frequency Generator (native qualification)",
    "version": "0.1.4",
    "architecture": "xtensa-esp32s3",
    "file_name": "frequency_generator.elf",
    "entry": "app_main",
    "requires": [
      {"capability": "display.output", "api": 1},
      {"capability": "input.touch.raw", "api": 1},
      {"capability": "audio.output", "api": 1},
      {"capability": "alarm.service", "api": 1},
      {"capability": "input.navigation", "api": 1}
    ],
    "optional": [
      {"capability": "board.battery", "api": 1},
      {"capability": "rtc.clock", "api": 2},
      {"capability": "storage.key-value", "api": 1},
      {"capability": "net.wifi", "api": 1},
      {"capability": "bluetooth.hci", "api": 1}
    ]
  }
}
